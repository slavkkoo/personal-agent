{
  "_comment": "Пример: два сервера-заглушки вместо app-паролей и своих скриптов. Скопируйте в config/mcp.json (в .gitignore), подставьте свои серверы и токены, chmod 600. Токены — с минимальными правами, лучше read-only.",
  "mcpServers": {
    "notes": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/notes-mcp-server", "--read-only"],
      "env": {
        "NOTES_API_TOKEN": "<read-only токен интеграции заметок/вики>"
      }
    },
    "todo": {
      "type": "http",
      "url": "https://mcp.example.com/todo/mcp",
      "headers": {
        "Authorization": "Bearer <токен трекера задач>"
      }
    }
  }
}
