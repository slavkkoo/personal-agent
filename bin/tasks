#!/usr/bin/env python3
"""Личный список задач владельца (плоский jsonl в memory/, без внешних сервисов).

Usage:
  tasks add "текст задачи" [--due YYYY-MM-DD] [--prio high|norm|low]
  tasks list [all]          # открытые (all — включая сделанные за 14 дней)
  tasks done <id>
  tasks drop <id>           # убрать без выполнения
"""
import datetime as dt
import json
import os
import sys

AHOME = os.environ.get("AGENT_HOME") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
F = os.path.join(AHOME, "memory", "tasks.jsonl")


def load():
    if not os.path.exists(F):
        return []
    out = []
    for line in open(F, encoding="utf-8"):
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def save(items):
    os.makedirs(os.path.dirname(F), exist_ok=True)
    with open(F, "w", encoding="utf-8") as f:
        for t in items:
            f.write(json.dumps(t, ensure_ascii=False) + "\n")


def show(items, include_done=False):
    mark = {"high": "🔴", "norm": "▫️", "low": "⚪"}
    today = dt.date.today().isoformat()
    open_t = [t for t in items if not t.get("done")]
    open_t.sort(key=lambda t: ({"high": 0, "norm": 1, "low": 2}[t.get("prio", "norm")],
                               t.get("due") or "9999"))
    if not open_t:
        print("Открытых задач нет.")
    for t in open_t:
        due = ""
        if t.get("due"):
            due = f" (до {t['due']}{' ⚠️ ПРОСРОЧЕНА' if t['due'] < today else ''})"
        print(f"  {mark[t.get('prio', 'norm')]} #{t['id']} {t['text']}{due}")
    if include_done:
        cutoff = (dt.date.today() - dt.timedelta(days=14)).isoformat()
        done = [t for t in items if t.get("done") and t.get("done_at", "") >= cutoff]
        if done:
            print("\nСделано (14 дней):")
            for t in done:
                print(f"  ✅ #{t['id']} {t['text']} ({t.get('done_at', '')})")


def main():
    a = sys.argv[1:]
    if not a:
        sys.exit(__doc__)
    items = load()
    if a[0] == "add":
        rest = a[1:]
        due = prio = None
        if "--due" in rest:
            i = rest.index("--due"); due = rest[i + 1]; rest = rest[:i] + rest[i + 2:]
            try:
                dt.date.fromisoformat(due)
            except ValueError:
                sys.exit("--due: формат YYYY-MM-DD")
        if "--prio" in rest:
            i = rest.index("--prio"); prio = rest[i + 1]; rest = rest[:i] + rest[i + 2:]
            if prio not in ("high", "norm", "low"):
                sys.exit("--prio: high|norm|low")
        text = " ".join(rest).strip()
        if not text:
            sys.exit("пустая задача")
        nid = max([t["id"] for t in items], default=0) + 1
        items.append({"id": nid, "text": text, "prio": prio or "norm", "due": due,
                      "done": False, "ts": dt.date.today().isoformat()})
        save(items)
        print(f"добавлена #{nid}: {text}")
    elif a[0] == "list":
        show(items, include_done=len(a) > 1 and a[1] == "all")
    elif a[0] in ("done", "drop"):
        if len(a) < 2 or not a[1].lstrip("#").isdigit():
            sys.exit(f"usage: tasks {a[0]} <id>")
        tid = int(a[1].lstrip("#"))
        for t in items:
            if t["id"] == tid:
                if a[0] == "done":
                    t["done"] = True
                    t["done_at"] = dt.date.today().isoformat()
                    print(f"✅ #{tid} {t['text']}")
                else:
                    items.remove(t)
                    print(f"убрана #{tid} {t['text']}")
                save(items)
                return
        sys.exit(f"нет задачи #{tid}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
