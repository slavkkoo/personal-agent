# personal-agent — настройки. Скопируйте в AGENT_HOME/.env, заполните, chmod 600.
# Файл читают и Python (bin/pa_common.py), и bash (`source`), поэтому:
#   - без пробелов вокруг «=»;
#   - значения с пробелами — в двойных кавычках;
#   - никаких $ и `бэктиков` в значениях.
# Пустое значение = не настроено (источник пропускается).

# ---------- Кто есть кто ----------
# Имя ассистента: подставляется в промпты, приветствие, пометку в GitLab.
ASSISTANT_NAME=
# Как называть владельца в промптах и в дампах переписок (ваши реплики будут подписаны так).
OWNER_NAME=
# Одна строка о вашей работе — контекст для PM-ментора, например:
# "продакт-менеджер SaaS «Acme» (сервис онлайн-записи)". Можно оставить пустым.
OWNER_ROLE=
# Ваш числовой Telegram ID. Бот отвечает ТОЛЬКО ему. Пусто — бот в режиме настройки:
# на любое личное сообщение отвечает ID отправителя и больше ничего не делает.
OWNER_ID=

# ---------- Бот ----------
# Токен бота от @BotFather (вида <цифры>:<буквы>).
BOT_TOKEN=

# ---------- Чтение вашего Telegram-аккаунта (Telethon, read-only) ----------
# api_id / api_hash — https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
# Имя файла сессии без .session; относительный путь — от AGENT_HOME. Создаётся bin/tg_login.py.
TG_SESSION=personal_reader
# Телефон для входа (+…); можно не заполнять — tg_login.py спросит.
TG_PHONE=

# ---------- Почта (IMAP, app-пароли Google; до MAIL5_*) ----------
# Порядок = порядок в брифинге: самый важный ящик — первым.
MAIL1_USER=
# App-пароль (16 букв). Google показывает его с пробелами — можно вставить как есть в кавычках.
MAIL1_PASS=
# Подпись ящика в брифинге (например: рабочий / личный).
MAIL1_LABEL=
# IMAP-хост; пусто = imap.gmail.com (Gmail и Google Workspace).
MAIL1_HOST=
# Имя корзины для этого ящика, если автоопределение по флагу \Trash не сработало.
MAIL1_TRASH=
MAIL2_USER=
MAIL2_PASS=
MAIL2_LABEL=
MAIL2_HOST=
MAIL2_TRASH=
# Корзина по умолчанию для всех ящиков. Пусто = "[Gmail]/Trash".
# В локализованном Gmail имя другое и в modified UTF-7 (для русского интерфейса —
# "[Gmail]/&BBoEPgRABDcEOAQ9BDA-"). Узнать точно: python3 bin/mail_triage.py list-folders
MAIL_TRASH=

# ---------- Календарь (секретные ICS-адреса Google Calendar; до CAL5_*) ----------
# Настройки календаря → «Интеграция календаря» → «Секретный адрес в формате iCal».
CAL1_ICS=
CAL1_LABEL=
CAL2_ICS=
CAL2_LABEL=

# ---------- GitLab (опционально; пусто — инструмент выключен) ----------
# Базовый URL инстанса, например https://gitlab.example.com
GITLAB_URL=
# Personal Access Token со scope api. Лучше — токен отдельного аккаунта или проекта.
GITLAB_TOKEN=
# Числовой id проекта или путь group/project.
GITLAB_PROJECT=
# Whitelist лейблов через запятую — ассистент ставит только их. Пример:
# "bug,feature,support,doc,needs-discussion"
GITLAB_LABELS=
# Пометка в описании задач, созданных ассистентом. edit правит только задачи с ней.
# Пусто = "Создано через ассистента <ASSISTANT_NAME>". Не меняйте после запуска —
# старые задачи перестанут считаться «своими».
GITLAB_MARKER=

# ---------- Модели и расписание ----------
# Модель для ответов вам в чате.
MODEL_ANSWER=claude-opus-5-5
# Модель для регулярных задач (брифинг, ментор).
MODEL_DUTY=claude-sonnet-5-5
# Ваш часовой пояс (IANA), например Europe/Berlin. По нему считаются расписания
# таймеров и даты в брифинге. После изменения — перезапустите ./install.sh.
TZ=
# Время утреннего брифинга HH:MM (по TZ).
BRIEFING_TIME=08:00
# День и время менторской сессии: Mon…Sun и HH:MM.
MENTOR_DAY=Fri
MENTOR_TIME=16:00
# Системный пользователь командного агента (team-os-agent), если он на том же сервере:
# личному агенту запрещено читать его домашний каталог.
TEAM_AGENT_USER=teamagent
